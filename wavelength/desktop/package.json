{
  "name": "wavelength",
  "productName": "Wavelength",
  "version": "1.0.0",
  "description": "A monochrome terminal-style music player with real flower imagery and synthesized audio.",
  "main": "main.js",
  "private": true,
  "author": "mininoodle",
  "license": "UNLICENSED",
  "scripts": {
    "assemble": "node assemble.js",
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "node assemble.js && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.mininoodle.wavelength",
    "productName": "Wavelength",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["main.js", "app/**/*"],
    "asar": true,
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "portable": { "artifactName": "Wavelength.exe" },
    "electronDownload": { "cache": "../.electron-cache" }
  }
}
